# ==========================================
# SkillBridge Environment Configuration
# ==========================================

# Frontend API URL
# - In Local Development: http://127.0.0.1:8000
# - In Vercel Production: Leave empty or omit (defaults to same-origin /api)
VITE_API_URL=http://127.0.0.1:8000

# Backend Database Configuration (Optional for PostgreSQL on Vercel/Neon/Supabase)
# If omitted, SQLite is used (/tmp/skillbridge.db on Vercel, ./skillbridge.db locally)
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/skillbridge_db?sslmode=require
