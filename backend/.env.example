# SkillBridge Backend Environment Configuration

PROJECT_NAME="SkillBridge API"
VERSION="1.0.0"
API_V1_STR="/api"

# CORS Origins (JSON array or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration:
# - In Local Development: SQLite (default) or Local PostgreSQL
# DATABASE_URL=sqlite:///./skillbridge.db

# - In Production (Vercel Serverless): REQUIRED Persistent Cloud PostgreSQL
# (Neon, Supabase, Vercel Postgres, AWS RDS, Railway, Render)
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/neondb?sslmode=require
# or (Supabase):
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

