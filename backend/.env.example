# SkillBridge Backend Environment Configuration

PROJECT_NAME="SkillBridge API"
VERSION="1.0.0"
API_V1_STR="/api"

# CORS Origins (JSON array or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL-ready)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillbridge_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillbridge_db
